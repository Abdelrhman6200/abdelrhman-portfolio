# Copy to .env and fill in.

# MySQL-compatible connection string.
DATABASE_URL=mysql://user:password@localhost:3306/appdb

# HMAC key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production — the app refuses to start without it when NODE_ENV=production.
SESSION_SECRET=

# --- AI features (optional) -------------------------------------------------
# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, or a local gateway.
# Left unset, AI features report themselves as unavailable rather than failing.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Owner notifications (optional) -----------------------------------------
# Any endpoint accepting a JSON POST (Slack, Discord, your own handler).
# Unset, notifications are logged and reported as undelivered.
OWNER_WEBHOOK_URL=
